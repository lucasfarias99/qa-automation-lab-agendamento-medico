{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Appointment Response Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "patientId", "doctorId", "scheduledAt",
    "status", "statusHistory", "testRunId", "createdAt", "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^apt_" },
    "patientId": { "type": "string", "pattern": "^pat_" },
    "doctorId": { "type": "string", "pattern": "^doc_" },
    "scheduledAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["SCHEDULED", "COMPLETED", "CANCELLED", "NO_SHOW"]
    },
    "notes": { "type": ["string", "null"] },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "changedAt"],
        "properties": {
          "from": {
            "type": ["string", "null"],
            "enum": ["SCHEDULED", "COMPLETED", "CANCELLED", "NO_SHOW", null]
          },
          "to": {
            "type": "string",
            "enum": ["SCHEDULED", "COMPLETED", "CANCELLED", "NO_SHOW"]
          },
          "changedAt": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      }
    },
    "testRunId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
