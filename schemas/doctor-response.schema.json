{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doctor Response Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "specialty", "workingHoursStart",
    "workingHoursEnd", "slotDurationMinutes", "active"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^doc_" },
    "name": { "type": "string" },
    "specialty": {
      "type": "string",
      "enum": ["CARDIOLOGIA", "DERMATOLOGIA", "ORTOPEDIA", "PEDIATRIA", "CLINICA_GERAL"]
    },
    "workingHoursStart": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "workingHoursEnd": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "slotDurationMinutes": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean" }
  }
}
