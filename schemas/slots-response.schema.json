{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slots Response Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["doctorId", "date", "slotDurationMinutes", "availableSlots", "bookedSlots"],
  "properties": {
    "doctorId": { "type": "string", "pattern": "^doc_" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "slotDurationMinutes": { "type": "integer", "minimum": 1 },
    "availableSlots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
    },
    "bookedSlots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
    }
  }
}
